-- VOLUME ----
--------------

-- Volume summary (monthly)
SELECT 
    BRANCH_GROUP,
    PRE_POST_IND,
    MIN(APPL_ENTRY_DT) AS MIN_APP_DT,
    MAX(APPL_ENTRY_DT) AS MAX_APP_DT,
    DATEDIFF(DAY, MIN_APP_DT, MAX_APP_DT) AS DURATION_DAY,
    
    COUNT(DISTINCT APPL_KEY) / DURATION_DAY * 30 AS MONTHLY_APP_CT,
    COUNT(DISTINCT CASE WHEN OFFER_TYPE IN ('multi offer', 'SDL', 'sec only') THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_APPROVED_APP_CT,
    COUNT(DISTINCT CASE WHEN HO_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_HO_APP_CT,
    COUNT(DISTINCT CASE WHEN HO_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_NHO_APP_CT,
    COUNT(DISTINCT CASE WHEN OFFER_TYPE IN ('multi offer', 'SDL', 'sec only') AND HO_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_APPROVED_HO_APP_CT,
    COUNT(DISTINCT CASE WHEN OFFER_TYPE IN ('multi offer', 'SDL', 'sec only') AND HO_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_APPROVED_NHO_APP_CT,
    
    COUNT(DISTINCT CASE WHEN HFS_QUOTE_CREATED_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_HFS_QUOTE_CT,
    
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Unsecured' THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_UNS_CT,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HFS_BOOKING_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_AS_CT,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HFS_BOOKING_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_HFS_CT,
    MONTHLY_AS_CT + MONTHLY_UNS_CT + MONTHLY_HFS_CT AS MONTHLY_TOTAL_ACCT_CT,
    
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Unsecured' AND HO_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_UNS_CT_HO,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HO_IND = 1 AND HFS_BOOKING_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_AS_CT_HO,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HO_IND = 1 AND HFS_BOOKING_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_HFS_CT_HO,
    MONTHLY_UNS_CT_HO + MONTHLY_AS_CT_HO + MONTHLY_HFS_CT_HO AS MONTHLY_TOTAL_ACCT_CT_HO,
    
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Unsecured' AND HO_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_UNS_CT_NHO,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HO_IND = 0 AND HFS_BOOKING_IND = 0 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_AS_CT_NHO,
    COUNT(DISTINCT CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HO_IND = 0 AND HFS_BOOKING_IND = 1 THEN APPL_KEY END) / DURATION_DAY * 30 AS MONTHLY_HFS_CT_NHO,
    MONTHLY_UNS_CT_NHO + MONTHLY_AS_CT_NHO + MONTHLY_HFS_CT_NHO AS MONTHLY_TOTAL_ACCT_CT_NHO,
    
    SUM(CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Unsecured' THEN NEW_MONEY END) / DURATION_DAY * 30 AS MONTHLY_UNS_NM,
    SUM(CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HFS_BOOKING_IND = 0 THEN NEW_MONEY END) / DURATION_DAY * 30 AS MONTHLY_AS_NM,
    SUM(CASE WHEN ACCT_KEY > 0 AND LOAN_TYPE = 'Secured' AND HFS_BOOKING_IND = 1 THEN NEW_MONEY END) / DURATION_DAY * 30 AS MONTHLY_HFS_NM, 
    
FROM APP_DRIVER_FINAL
WHERE 1 = 1
    AND PRE_POST_IND IS NOT NULL
    AND APPL_STAT <> 'PEND'
    AND APPL_ENTRY_DT < DATEADD(DAY, -7, CURRENT_DATE())
    AND (CUST_TYPE IN ('NC', 'FC') OR JOINT_IND = 'J')
GROUP BY 1, 2
ORDER BY 1, 2
;
