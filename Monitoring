------------------
-- DRIVER TABLE --
------------------

CREATE OR REPLACE TEMPORARY TABLE APP_DRIVER AS (
    SELECT 
        A.APPL_KEY, A.ACAP_REFR_ID, A.APPLICATION_N, ACCT_KEY, THREAD_ACCT_KEY, APPL_ENTRY_DT, TRAN_DATE, APPL_STAT, OWN_SCORE_BRNCH, REACTIVE_FLAG, P_ADR_ST, P_ADR_CITY, P_ADR_ZIP, P_ADR_ZIP4, 
        RSK_LVL, INCOME_DISCLOSED_TOTAL, INCOME_ENTERED_TOTAL, INCOME_VERIFIED_TOTAL, NDI, VANTAGE_PRIM, FICO_BLEND, FICO_BLEND_2, CUST_TYPE, HOMEOWNER, 
        OFFER_TYPE, 
        CASE WHEN SPECIAL_TREATMENT_C = 'HF' AND TST_CTL_3_CD IN ('N5', 'F5') THEN 'SDL' ELSE OFFER_TYPE END AS OFFER_TYPE_,
        CASE WHEN LOAN_PROD_CD_PLR = 'PU' THEN 'Unsecured' WHEN LOAN_PROD_CD_PLR IN ('A1','P1','A2','P2','A3','P3','A4','P4','P5','P6','PP','PS') THEN 'Secured' END AS LOAN_TYPE,
        CASE WHEN MAX_AMT_ALL IS NOT NULL THEN 1 ELSE 0 END AS ANY_QUOTE_CREATED_IND, -- from table with 2 day lag
        CASE WHEN D.MAX_HFS_AMT IS NOT NULL THEN 1 ELSE 0 END AS HFS_QUOTE_CREATED_IND, -- from table with 2 day lag
        CASE WHEN D.FINAL_COLLAT ILIKE '%UCC%' AND ACCT_KEY > 0 THEN 1 ELSE 0 END AS HFS_BOOKING_IND, -- from table with 2 day lag
        LOAN_TYP AS JOINT_IND,
        CRDT_LMT_RQST_AM, SEC_OFFER_AMT, UNSEC_OFFER_AMT, LOAN_AMT, AMOUNT_M, NET_VOL, AMT_FIN, NEW_MONEY, APR, TERM,
        RD_NM, DM_NM, BRANCH_ZIP, BRANCH_ST, BRANCH_NM, BRANCH_N_ORIG,
        DEBT_VALUE AS AUTO_DEBT_VALUE, COLLAT_VALUE AS AUTO_VALUE, COLLAT_AGE AS AUTO_AGE, AUTO_MAKE, AUTO_MODEL,
        QUOTE_CT, MAX_AUTO_AMT, MAX_HFS_AMT, MAX_UNS_AMT, MIN_AUTO_APR, MIN_HFS_APR, MIN_UNS_APR, FINAL_COLLAT, FINAL_AMT, FINAL_APR,
        TRANSFER_FLAG,
        DATEDIFF(DAY, APPL_ENTRY_DT, TRAN_DATE) AS CLOSING_TIME_DAY,
        CASE 
            WHEN OWN_SCORE_BRNCH IN (3922, 2017, 3932, 1374, 2426, 3924, 3937, 1010, 4809, 1000, 4811, 1007, 1011, 1008, 1006) THEN 'Phase 2'
            WHEN OWN_SCORE_BRNCH IN (1013, 3926) THEN 'Phase 1'
            END AS BRANCH_GROUP,
        CASE 
            WHEN OWN_SCORE_BRNCH IN (1013, 3926) THEN (CASE WHEN APPL_ENTRY_DT < '2026-02-08' THEN '1. PRE' ELSE '2. POST' END)
            WHEN OWN_SCORE_BRNCH IN (3922, 2017, 3932, 1374, 2426, 3924, 3937, 1010, 4809, 1000, 4811, 1007, 1011, 1008, 1006) THEN (CASE WHEN APPL_ENTRY_DT < '2026-03-06' THEN '1. PRE' ELSE '2. POST' END)
            END AS PRE_POST_IND
    FROM BDM.APP_LOAN_PRODUCTION A
    LEFT JOIN (
        SELECT
            BRANCH_N,
            APPLICATION_N,
            FIRST_VALUE(COLLATERAL_TYPE_C) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS COLLATERAL_TYPE_C,
            FIRST_VALUE(COLLATERAL_CATEGORY_C) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS COLLATERAL_CATEGORY_C,
            FIRST_VALUE(TEMP_DEFAULT_BODY_STYLE_X) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS DESCRIPTION,
            FIRST_VALUE('NA') OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS CODED_VALUE_C,
            FIRST_VALUE(AUTO_VALUE_M) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS COLLAT_VALUE,
            FIRST_VALUE(DEBT_BALANCE_N) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS DEBT_VALUE,
            FIRST_VALUE(AUTO_MAKE_X) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS AUTO_MAKE,
            FIRST_VALUE(AUTO_MODEL_X) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) AS AUTO_MODEL,
            CASE 
                WHEN FIRST_VALUE(AUTO_YEAR_N) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) = 0 THEN NULL
                ELSE YEAR(CURRENT_DATE()) - FIRST_VALUE(AUTO_YEAR_N) OVER (PARTITION BY BRANCH_N, APPLICATION_N ORDER BY LAST_CHANGE_D DESC) END AS COLLAT_AGE
        FROM ODS.SAT_APPLICATION_AUTO 
    ) C ON A.OWN_SCORE_BRNCH = C.BRANCH_N AND A.APPLICATION_N = C.APPLICATION_N AND C.AUTO_MAKE IS NOT NULL AND C.AUTO_MODEL IS NOT NULL AND C.COLLAT_VALUE IS NOT NULL AND COLLAT_VALUE > 0
    LEFT JOIN (
        SELECT
            BRANCH_N, APPLICATION_N, SPECIAL_TREATMENT_C,
            MAX(CASE WHEN COLLATERAL_CAT_CD_X ILIKE '%AUTO%' THEN BASE_AMOUNT_M END) AS MAX_AUTO_AMT,
            MAX(CASE WHEN COLLATERAL_CAT_CD_X ILIKE '%UCC%' THEN BASE_AMOUNT_M END) AS MAX_HFS_AMT,
            MAX(CASE WHEN COLLATERAL_CAT_CD_X = '          ' THEN BASE_AMOUNT_M END) AS MAX_UNS_AMT,
            MAX(BASE_AMOUNT_M) AS MAX_AMT_ALL,
            MIN(CASE WHEN COLLATERAL_CAT_CD_X ILIKE '%AUTO%' AND REC_TYPE_X <> 'Q' THEN APR_RATE_P END) AS MIN_AUTO_APR,
            MIN(CASE WHEN COLLATERAL_CAT_CD_X ILIKE '%UCC%' AND REC_TYPE_X <> 'Q' THEN APR_RATE_P END) AS MIN_HFS_APR,
            MIN(CASE WHEN COLLATERAL_CAT_CD_X = '          ' AND REC_TYPE_X <> 'Q' THEN APR_RATE_P END) AS MIN_UNS_APR,
            MAX(CASE WHEN REC_TYPE_X = 'B' THEN BASE_AMOUNT_M END) AS FINAL_AMT,
            MAX(CASE WHEN REC_TYPE_X = 'B' THEN APR_RATE_P END) AS FINAL_APR,
            MAX(CASE WHEN REC_TYPE_X = 'B' THEN COLLATERAL_CAT_CD_X END) AS FINAL_COLLAT,
            SUM(CASE WHEN REC_TYPE_X IN ('B', 'S') THEN 1 ELSE 0 END) AS QUOTE_CT
        FROM EDS.DIALER.UOPLGT00 -- this table has a 2 day lag
        WHERE QUOTE_TYPE_C NOT IN ('1', '2') --AND REC_TYPE_X <> 'Q' -- filter to saved/approved/booked quotes
        GROUP BY 1, 2, 3 
    ) D ON A.OWN_SCORE_BRNCH = D.BRANCH_N AND A.APPLICATION_N = D.APPLICATION_N 
    LEFT JOIN SA.RR_STRGY_MSTR E ON A.APPL_KEY = E.APPL_KEY
    LEFT JOIN (
        SELECT APPL_KEY, TST_CTL_3_CD
        FROM Q1.RR_STRGY_CHCL_CNTL
        WHERE DATE(SC_TS) >= '2018-01-01' AND G4_REC_TYP = 1
        QUALIFY ROW_NUMBER() OVER (PARTITION BY APPL_KEY ORDER BY SC_TS DESC) = 1
    ) F ON A.APPL_KEY = F.APPL_KEY
    WHERE 1 = 1
        AND APPL_ENTRY_DT >= '2026-01-01'
        AND A.ACAP_REFR_ID IS NOT NULL AND A.APPL_KEY IS NOT NULL
        AND CORE_V_CAPP = 'Core' 
        AND CUST_TYPE IN ('NC', 'FC', 'PC') 
);


-- Get bureau mortgage info
CREATE OR REPLACE TEMPORARY TABLE CB_INFO AS (
    SELECT 
        ACAP_REFR_ID, CB_KEY, EXSUBIND, SUBIND, CBCODE, 
        MAX(KEYHTNBR) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::NUMERIC AS KEYHTNBR,
        CASE 
            WHEN EXSUBIND = 'J' THEN MAX(KEYHTNBR) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::NUMERIC - 2
            ELSE MAX(KEYHTNBR) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::NUMERIC END AS PRI_CB_SEQ_NO,
        CASE 
            WHEN EXSUBIND = 'J' THEN MAX(KEYHTNBR) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::NUMERIC - 1
            WHEN EXSUBIND = 'S' THEN MAX(KEYHTNBR) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::NUMERIC
            ELSE NULL END AS SEC_CB_SEQ_NO,
        MAX(REQTS) OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC)::TIMESTAMP AS REQTS
    FROM SA.RR_BL
    WHERE DATE(REQTS)::DATE >= '2026-01-01' :: DATE - 30
    QUALIFY ROW_NUMBER() OVER (PARTITION BY ACAP_REFR_ID ORDER BY REQTS DESC) = 1
);

CREATE OR REPLACE TEMPORARY TABLE APP_DRIVER_CB AS (
    SELECT A.*, B.CB_KEY, PRI_CB_SEQ_NO, SEC_CB_SEQ_NO, MTA0300, CASE WHEN (MTA0300 BETWEEN 1 AND 89 OR HOMEOWNER = 'H') THEN 1 ELSE 0 END AS HO_IND
    FROM APP_DRIVER A
    LEFT JOIN CB_INFO B ON A.ACAP_REFR_ID = B.ACAP_REFR_ID
    LEFT JOIN SA.CB_ATTR_ATB_ATB03 C ON B.CB_KEY = C.CB_KEY AND B.PRI_CB_SEQ_NO = C.CB_SEQ_NO AND RECORD_CREATED_TIMESTAMP >= '2026-01-01' :: DATE - 30
);

CREATE OR REPLACE TEMPORARY TABLE APP_DRIVER_FINAL AS (SELECT * FROM APP_DRIVER_CB QUALIFY ROW_NUMBER() OVER (PARTITION BY APPL_KEY ORDER BY APPL_ENTRY_DT DESC) = 1);


